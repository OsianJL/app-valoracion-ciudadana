{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valoracion-ciudadana",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "valoracion-ciudadana",
      "database_id": "3c168cbd-db71-4361-98b3-b9adab622bbe",
      "migrations_dir": "migrations"
    }
  ]
}
